# Server Configuration
PORT=5000
NODE_ENV=development

# Hostinger SMTP Configuration (Used for sending cold outreach emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=muddassir@veloxisglobal.com
SMTP_PASS=your_hostinger_email_password

# Supabase Configuration (Used for database storage)
# You can find these in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Puppeteer Configuration
# Optional: Set executable path if running custom chromium installation
# PUPPETEER_EXECUTABLE_PATH=

# Brevo SMTP/API Configuration (Alternative / Fallback)
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER_EMAIL=muddassir@veloxisglobal.com
BREVO_SENDER_NAME="Muddassir Ali"

# Apollo B2B API Key (Free tier available at apollo.io)
APOLLO_API_KEY=your_apollo_api_key_here

# WhatsApp Notification API (CallMeBot)
